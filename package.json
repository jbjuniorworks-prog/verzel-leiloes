{
  "name": "martelo-leiloes",
  "private": true,
  "version": "1.0.0",
  "description": "Martelo — Casa de Leilões online (teste técnico Elite Dev Verzel)",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev -w @leilao/api\" \"npm run dev -w @leilao/web\"",
    "db:up": "docker compose up -d db",
    "db:migrate": "npm run db:migrate -w @leilao/api",
    "db:seed": "npm run db:seed -w @leilao/api",
    "db:reset": "npm run db:reset -w @leilao/api",
    "keys:generate": "npm run keys:generate -w @leilao/api",
    "build": "npm run build -w @leilao/web && npm run build -w @leilao/api",
    "start": "npm run start -w @leilao/api",
    "test": "npm run test -w @leilao/shared && npm run test -w @leilao/web && npm run test -w @leilao/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "concurrently": "9.2.5",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  }
}
