# Banco (o docker-compose expõe o Postgres na porta 5433)
DATABASE_URL="postgresql://leilao:leilao@localhost:5433/leilao"
# Usado só pelos testes de integração (banco separado, criado pelo docker/postgres/init-test-db.sql)
TEST_DATABASE_URL="postgresql://leilao:leilao@localhost:5433/leilao_test"

PORT=3333

# Segredos de DESENVOLVIMENTO. Em produção gere novos com: npm run keys:generate
JWT_SECRET="dev-jwt-secret-troque-em-producao-0123456789abcdef"
# Semente Ed25519 (32 bytes em base64) que assina o histórico de lances. Nunca fica no banco.
AUDIT_PRIVATE_KEY="ZGV2LW9ubHktYXVkaXQta2V5LW5vdC1mb3ItcHJvZCE="
# Segredo do HMAC que gera os pseudônimos dos licitantes.
PSEUDONYM_SECRET="dev-pseudonym-secret-troque-em-producao"

# API externa de itens. Aponte para uma URL inválida para simular a API fora do ar.
SCRYFALL_BASE_URL="https://api.scryfall.com"

# Cria leiloeiro, licitantes e lotes de demonstração ao subir (idempotente).
SEED_ON_BOOT=false
