{
  "name": "@leilao/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "prisma generate && tsup",
    "start": "prisma migrate deploy && node dist/server.js",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file-if-exists=.env src/seed/run.ts",
    "db:reset": "prisma migrate reset --force --skip-seed && npm run db:seed",
    "keys:generate": "tsx src/scripts/generate-keys.ts",
    "test": "vitest run",
    "typecheck": "prisma generate && tsc --noEmit -p ."
  },
  "dependencies": {
    "@leilao/shared": "*",
    "@prisma/client": "6.19.3",
    "cookie-parser": "1.4.7",
    "express": "5.1.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "prisma": "6.19.3",
    "socket.io": "4.8.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.20.5",
    "@types/supertest": "6.0.3",
    "socket.io-client": "4.8.4",
    "supertest": "7.3.1",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "vitest": "3.2.7"
  }
}
